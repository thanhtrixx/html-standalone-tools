{
  "name": "html-standalone-tools",
  "version": "1.0.0",
  "description": "A set of html standalone tools",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "verify": "./scripts/run.sh scripts/verify.js",
    "build": "./scripts/run.sh scripts/build.js",
    "build:sync": "./scripts/run.sh scripts/build.js",
    "build:predictor": "./scripts/run.sh scripts/build.js --tool personal-finance-savings-predictor",
    "build:buy-rent": "./scripts/run.sh scripts/build.js --tool buy-vs-rent-home-comparison",
    "build:tracker": "./scripts/run.sh scripts/build.js --tool smart-buy-list-price-tracker",
    "slides:buy-rent": "./scripts/run.sh -x @slidev/cli buy-vs-rent-home-comparison/slides.md",
    "test": "./scripts/run.sh scripts/run-tests.js",
    "test:all": "./scripts/run.sh scripts/run-tests.js",
    "test:report": "./scripts/run.sh scripts/run-tests.js",
    "test:build": "./scripts/run.sh tests/build.test.js",
    "test:i18n": "./scripts/run.sh tests/i18n.test.js",
    "test:sim": "./scripts/run.sh tests/simulation.test.js",
    "test:buy-rent": "./scripts/run.sh tests/buy-vs-rent-simulation.test.js",
    "test:buy-rent:ui": "./scripts/run.sh tests/buy-vs-rent-ui-i18n.test.js",
    "test:buy-rent:charts": "./scripts/run.sh tests/buy-vs-rent-charts.test.js",
    "test:buy-rent:dossier": "./scripts/run.sh tests/buy-vs-rent-sharing-dossier.test.js",
    "test:buy-rent:tooltips": "./scripts/run.sh tests/buy-vs-rent-tooltips-formulas.test.js",
    "test:tracker": "./scripts/run.sh scripts/run-tests.js --tool smart-buy-list-price-tracker",
    "test:tracker:math": "./scripts/run.sh tests/smart-buy-list-engine-math.test.js",
    "test:tracker:storage": "./scripts/run.sh tests/smart-buy-list-storage-persistence.test.js",
    "test:tracker:cloud": "./scripts/run.sh tests/smart-buy-list-cloud-sync.test.js",
    "test:tracker:ui": "./scripts/run.sh tests/smart-buy-list-ui-components.test.js",
    "test:tracker:pwa": "./scripts/run.sh tests/smart-buy-list-pwa-lifecycle.test.js",
    "test:tracker:i18n": "./scripts/run.sh tests/smart-buy-list-i18n.test.js",
    "test:tracker:security": "./scripts/run.sh tests/smart-buy-list-security.test.js",
    "test:helpers": "./scripts/run.sh tests/helpers.test.js",
    "test:ui": "./scripts/run.sh tests/ui-ux.test.js",
    "format": "prettier --write .",
    "lint:check": "prettier --check .",
    "pack:release": "./scripts/run.sh scripts/pack-release.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thanhtrixx/html-standalone-tools.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/thanhtrixx/html-standalone-tools/issues"
  },
  "homepage": "https://github.com/thanhtrixx/html-standalone-tools#readme",
  "devDependencies": {
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "terser": "^5.50.0"
  }
}

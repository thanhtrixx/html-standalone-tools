{
  "name": "Atomic Habit & Routine Tracker",
  "short_name": "Habits",
  "version": "1.0.0",
  "description": "Mobile-first PWA habit & routine tracker with 52-week calendar heatmaps and local-first IndexedDB persistence",
  "start_url": "./index.html",
  "display": "standalone",
